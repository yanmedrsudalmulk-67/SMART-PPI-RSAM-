# --- VERCEL DEPLOYMENT CONFIGURATION ---
# Pastikan variabel ini diatur di Vercel Dashboard > Settings > Environment Variables

# Supabase Configuration
# Temukan di Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Gemini AI Configuration (Jika digunakan)
# Temukan di https://aistudio.google.com/app/apikey
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# App URL (Opsional di Vercel, biasanya otomatis dideteksi)
APP_URL=https://your-app-name.vercel.app
